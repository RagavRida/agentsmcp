{
  "name": "agentsmcp",
  "version": "0.5.2",
  "description": "Context-sync protocol for AI agents. Every agent has a mailbox.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agentsmcp": "dist/mcp/index.js",
    "agentsmcp-server": "dist/server.js",
    "agentmailbox-server": "dist/server.js",
    "agentsmcp-index": "dist/scripts/index-codebase.js"
  },
  "files": [
    "dist/",
    "ui/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "cd parser && npx tsc -p tsconfig.cjs.json && cd .. && npm run clean && tsc && npx tsc scripts/index-codebase.ts --outDir dist/scripts --target ES2020 --module commonjs --esModuleInterop --skipLibCheck --resolveJsonModule && node scripts/finalize-mcp.js && npm run build:web",
    "build:desktop": "npm run build && tsc -p electron/tsconfig.json",
    "dev:electron": "npm run build:desktop && AGENTMAILBOX_NODE_PATH=$(command -v node) electron dist-electron/main.js",
    "package:mac:dir": "npm run build:desktop && sh -c 'trap \"npm rebuild better-sqlite3 cpu-features\" EXIT; HOME=.electron-home npm_config_devdir=.electron-gyp electron-builder --mac --dir'",
    "package:mac": "npm run build:desktop && sh -c 'trap \"npm rebuild better-sqlite3 cpu-features\" EXIT; HOME=.electron-home npm_config_devdir=.electron-gyp electron-builder --mac'",
    "build:web": "vite build && tsc -p tsconfig.ui.json --noEmit",
    "eval:llm-judge": "ts-node scripts/run-llm-judge.ts",
    "start": "ts-node src/server.ts",
    "example": "ts-node examples/basic.ts",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:e2e": "npm run build && node scripts/smoke-e2e.js",
    "verify:package": "node scripts/verify-package-bins.js",
    "prepack": "npm run build && npm run verify:package",
    "prepublishOnly": "npm run build && npm test && npm run verify:package"
  },
  "keywords": [
    "agents",
    "ai",
    "context",
    "protocol",
    "mailbox",
    "llm",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RagavRida/agentsmcp.git"
  },
  "homepage": "https://agentmailbox.vercel.app",
  "author": "AgentMailbox",
  "bugs": {
    "url": "https://github.com/RagavRida/agentsmcp/issues"
  },
  "license": "MIT",
  "build": {
    "appId": "com.agentmailbox.desktop",
    "productName": "AgentMailbox",
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "directories": {
      "output": "release"
    },
    "artifactName": "AgentMailbox-${version}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/cpu-features/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.inherit.plist",
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.24.0",
    "neo4j-driver": "^6.1.0",
    "pg": "^8.11.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ssh2-sftp-client": "^12.1.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.27.0",
    "openai": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "openai": "^4.50.0",
    "pino-pretty": "^11.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.21",
    "vitest": "^2.0.0"
  }
}
