# AgentsMCP Environment Variables

# ─── Core ───────────────────────────────────────────────────────────
# HTTP port (default: 3000)
PORT=3000

# Database connection string or SQLite file path
# SQLite: agentmailbox.db (default)
# Postgres: postgresql://user:pass@host:5432/dbname
AGENTSMCP_DB=agentmailbox.db

# Enable SSL for Postgres connections (default: false)
AGENTSMCP_DB_SSL=false

# API key for self-hosted single-tenant authentication
# Generate: openssl rand -hex 32
# AGENTSMCP_API_KEY=

# ─── Cloud Mode ─────────────────────────────────────────────────────
# Enable cloud features: multi-tenant auth, CORS, rate limiting, audit
CLOUD_MODE=false

# GitHub OAuth credentials (required when CLOUD_MODE=true)
# Create at: https://github.com/settings/developers
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# JWT secret for session tokens (required when CLOUD_MODE=true)
# Generate: openssl rand -hex 64
# JWT_SECRET=

# ─── Logging ────────────────────────────────────────────────────────
# Log level: fatal | error | warn | info | debug | trace
# Default: info (production), debug (development)
# LOG_LEVEL=info

# ─── AI Compression (optional) ──────────────────────────────────────
# Anthropic API key for Claude-powered context compression
# ANTHROPIC_API_KEY=

# OpenAI API key for GPT-powered context compression
# OPENAI_API_KEY=

# ─── Postgres Pool (optional) ───────────────────────────────────────
# Max pool connections (default: 10)
# POSTGRES_POOL_MAX=20

# ─── Rate Limiting (optional, cloud mode) ───────────────────────────
# Max agents per IP (default: 10)
# AGENTSMCP_MAX_AGENTS_PER_IP=10

# Max messages per day per user (default: 500)
# AGENTSMCP_MAX_MESSAGES_PER_DAY=500

# ─── Codebase Indexer (CI) ──────────────────────────────────────────
# Server URL for the indexer script
# AGENTSMCP_SERVER=https://your-server.example.com

# Agent ID for indexing (default: project@index)
# AGENTSMCP_AGENT_ID=project@index

# Indexer concurrency (default: 8)
# AGENTSMCP_CONCURRENCY=8

# Max file size in KB (default: 512)
# AGENTSMCP_MAX_FILE_KB=512

# Verbose indexer output
# AGENTSMCP_VERBOSE=true
