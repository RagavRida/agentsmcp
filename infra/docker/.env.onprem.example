# ============================================================
# AgentMailbox — On-Prem Environment Configuration
#
# Copy to .env and customize for your deployment.
# All services run locally. No external API calls.
# ============================================================

# ── GPU & Model ───────────────────────────────────────────
# Auto-selected by deploy-onprem.sh, or set manually:
# VLLM_MODEL=Qwen/Qwen2.5-3B-Instruct       # T4 (16GB)
# VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct       # L4 (24GB)
# VLLM_MODEL=deepseek-ai/DeepSeek-V2-Lite-Chat  # A100 (MLA)
VLLM_MODEL=Qwen/Qwen2.5-3B-Instruct
MAX_MODEL_LEN=4096
GPU_MEM_UTIL=0.85
GPU_COUNT=1

# ── Embedding ─────────────────────────────────────────────
EMBED_MODEL=BAAI/bge-large-en-v1.5
EMBED_GPU=0

# ── Neo4j ─────────────────────────────────────────────────
NEO4J_USER=neo4j
NEO4J_PASS=replace-with-a-secret-at-least-32-characters
NEO4J_HEAP=2G

# ── MinIO (S3-Compatible Storage) ─────────────────────────
S3_ACCESS_KEY=replace-with-a-secret-access-key
S3_SECRET_KEY=replace-with-a-secret-at-least-32-characters
S3_BUCKET=agentmailbox

# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_DB=agentsmcp
POSTGRES_USER=agentsmcp
POSTGRES_PASSWORD=replace-with-a-secret-at-least-32-characters
AGENTSMCP_API_KEY=replace-with-a-long-random-api-key

# ── Ports ─────────────────────────────────────────────────
APP_PORT=3000
HTTPS_PORT=443
HTTP_PORT=80

# ── Security ──────────────────────────────────────────────
VLLM_API_KEY=replace-with-a-long-random-api-key
SESSION_ID=production

# ── TLS ────────────────────────────────────────────────────
TLS_CERT_PATH=./certs/fullchain.pem
TLS_KEY_PATH=./certs/privkey.pem

# ── HuggingFace (for model download, optional) ───────────
# Set if behind firewall with HF mirror:
# HF_ENDPOINT=https://your-hf-mirror.internal
# HF_TOKEN=your-token-here
